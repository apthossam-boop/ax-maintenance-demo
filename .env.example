# AX / SQL connection (fill locally in .env — never commit secrets)
AX_HOST=YOUR_AX_SERVER_IP
AX_SERVICES_PORT=8101
AX_AOS_PORT=2712
AX_SERVICE_GROUP=MBSMaintPortalServiceGroup
AX_COMPANY=apt
AX_LANGUAGE=en-us
AX_DOMAIN=YOUR_DOMAIN
AX_USERNAME=YOUR_USER
AX_PASSWORD=

# mock | sql | live
AX_MODE=sql

SQL_SERVER=YOUR_SQL_SERVER_IP
SQL_PORT=49646
SQL_DATABASE=MicrosoftDynamicsAX
SQL_DOMAIN=YOUR_DOMAIN
SQL_USERNAME=YOUR_USER
SQL_PASSWORD=
SQL_DATAAREAID=apt
SQL_LIST_LIMIT=300

PORT=8080
HOST=127.0.0.1

