@echo off
set OUT=C:\Users\Public\ax_sql_probe3.txt
echo PROBE3> "%OUT%"
sqlcmd -S localhost\APTALEX -E -d MicrosoftDynamicsAX -Q "SELECT TOP 5 TABLE_NAME FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME LIKE '%%WORKER%%' OR TABLE_NAME LIKE '%%MBS_WORKSHOPWORKER%%';" >> "%OUT%" 2>&1
sqlcmd -S localhost\APTALEX -E -d MicrosoftDynamicsAX -Q "SELECT COLUMN_NAME FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME='MBS_WORKSHOPWORKERS_TABLE' ORDER BY ORDINAL_POSITION;" >> "%OUT%" 2>&1
sqlcmd -S localhost\APTALEX -E -d MicrosoftDynamicsAX -Q "SELECT COLUMN_NAME FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME='MBS_WORKSHOPORDERSTABLE' ORDER BY ORDINAL_POSITION;" >> "%OUT%" 2>&1
sqlcmd -S localhost\APTALEX -E -d MicrosoftDynamicsAX -Q "SELECT COLUMN_NAME FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME='MBS_WORKSHOPORDERITEMS' ORDER BY ORDINAL_POSITION;" >> "%OUT%" 2>&1
sqlcmd -S localhost\APTALEX -E -d MicrosoftDynamicsAX -W -Q "SELECT TOP 20 s.MBS_WORKSHOPORDERID, s.ITEMID, s.TOOLSERIAL, s.TELNO, s.CUSTACCOUNT, s.CUSTNAME, s.MBS_WORKORDERSTATUS, s.OPERATIONSTATUS, o.PRICE, o.SERIVCESTATUS, o.OPERATIONSTATUS AS OPSTATUS, o.WORKER, o.SEARCHNAME FROM MBS_WORKSHOPORDERSSERVICES s LEFT JOIN MBS_WORKSHOPORDEROPERATIONS o ON o.MBS_WORKSHOPORDERID=s.MBS_WORKSHOPORDERID AND o.MBS_WORKSHOPORDERSSERVICESRECID=s.RECID WHERE s.DATAAREAID='apt' AND NULLIF(LTRIM(RTRIM(s.TELNO)),'') IS NOT NULL ORDER BY s.CREATEDDATETIME DESC;" >> "%OUT%" 2>&1
sqlcmd -S localhost\APTALEX -E -d MicrosoftDynamicsAX -Q "SELECT COUNT(*) AS Cnt FROM MBS_WORKSHOPORDERSSERVICES WHERE DATAAREAID='apt'; SELECT TOP 10 TELNO, COUNT(*) C FROM MBS_WORKSHOPORDERSSERVICES WHERE DATAAREAID='apt' AND NULLIF(LTRIM(RTRIM(TELNO)),'') IS NOT NULL GROUP BY TELNO ORDER BY C DESC;" >> "%OUT%" 2>&1
echo END>> "%OUT%"
